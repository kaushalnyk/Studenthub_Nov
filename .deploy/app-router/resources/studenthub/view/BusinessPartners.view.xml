<mvc:View
  controllerName="studenthub.nov.controller.BusinessPartners"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:m="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <m:Page id="bpPage" title="{i18n>businessPartnersTitle}" showNavButton="true" navButtonPress="onNavBack" class="studentHubShell">

    <m:headerContent>
      <m:Toolbar>
        <m:SearchField
          id="bpSearch"
          width="15rem"
          placeholder="{i18n>bpSearchPlaceholder}"
          search="onSearchName" />
        <m:Select id="bpCategory" width="10rem" change="onCategoryChange">
          <m:items>
            <core:Item key="" text="{i18n>allCategories}" />
            <core:Item key="1" text="{i18n>person}" />
            <core:Item key="2" text="{i18n>organization}" />
          </m:items>
        </m:Select>
        <m:Input id="latestCount" width="4rem" value="10" type="Number" />
        <m:Button text="{i18n>latest}" icon="sap-icon://history" press="onLatest" />
        <m:Button text="{i18n>byUUID}" icon="sap-icon://search" press="onOpenUuidDialog" />
        <m:ToolbarSpacer />
        <m:Button icon="sap-icon://refresh" tooltip="{i18n>refresh}" press="onRefresh" />
      </m:Toolbar>
    </m:headerContent>

    <m:content>
      <m:Table id="bpTable" width="100%" growing="true" items="{bp>/partners}" noDataText="No business partners found">
        <m:headerToolbar>
          <m:OverflowToolbar>
            <m:Title text="{i18n>businessPartnersTitle}" level="H2" />
            <m:ToolbarSpacer />
            <m:Text id="bpCountText" text="" />
          </m:OverflowToolbar>
        </m:headerToolbar>
        <m:columns>
          <m:Column width="10rem"><m:Text text="{i18n>businessPartner}" /></m:Column>
          <m:Column><m:Text text="{i18n>name}" /></m:Column>
          <m:Column width="8rem"><m:Text text="{i18n>category}" /></m:Column>
          <m:Column width="20rem"><m:Text text="{i18n>uuid}" /></m:Column>
          <m:Column width="9rem"><m:Text text="{i18n>created}" /></m:Column>
          <m:Column width="13rem"><m:Text text="{i18n>actions}" /></m:Column>
        </m:columns>
        <m:items>
          <m:ColumnListItem vAlign="Middle">
            <m:cells>
              <m:Text text="{bp>BusinessPartner}" />
              <m:Text text="{bp>BusinessPartnerFullName}" />
              <m:Text text="{bp>BusinessPartnerCategory}" />
              <m:Text text="{bp>BusinessPartnerUUID}" />
              <m:Text text="{bp>CreationDate}" />
              <m:Toolbar class="detailIconButton">
                <m:Button icon="sap-icon://detail-view" tooltip="Details" press="onBpDetails" />
                <m:Button icon="sap-icon://text" tooltip="Get name" press="onBpName" />
                <m:Button icon="sap-icon://sys-enter-2" tooltip="Check existence" press="onBpExists" />
              </m:Toolbar>
            </m:cells>
          </m:ColumnListItem>
        </m:items>
      </m:Table>
    </m:content>

    <m:footer>
      <m:OverflowToolbar>
        <m:Text text="Data comes from the connected S/4HANA sandbox (API_BUSINESS_PARTNER)." />
      </m:OverflowToolbar>
    </m:footer>
  </m:Page>

  <!-- Details dialog -->
  <m:Dialog id="bpDetailsDialog" title="{i18n>bpDetails}" type="Standard" contentWidth="520px">
    <m:content>
      <m:VBox class="sapUiSmallMargin">
        <m:HBox alignItems="Center" class="sapUiTinyMarginBottom">
          <m:Label text="{i18n>businessPartner}" width="12rem" />
          <m:Text text="{bp>/details/BusinessPartner}" />
        </m:HBox>
        <m:HBox alignItems="Center" class="sapUiTinyMarginBottom">
          <m:Label text="{i18n>name}" width="12rem" />
          <m:Text text="{bp>/details/BusinessPartnerFullName}" />
        </m:HBox>
        <m:HBox alignItems="Center" class="sapUiTinyMarginBottom">
          <m:Label text="{i18n>category}" width="12rem" />
          <m:Text text="{bp>/details/BusinessPartnerCategory}" />
        </m:HBox>
        <m:HBox alignItems="Center" class="sapUiTinyMarginBottom">
          <m:Label text="{i18n>uuid}" width="12rem" />
          <m:Text text="{bp>/details/BusinessPartnerUUID}" />
        </m:HBox>
        <m:HBox alignItems="Center">
          <m:Label text="{i18n>created}" width="12rem" />
          <m:Text text="{bp>/details/CreationDate}" />
        </m:HBox>
      </m:VBox>
    </m:content>
    <m:endButton>
      <m:Button text="{i18n>close}" press="onCloseDetailsDialog" />
    </m:endButton>
  </m:Dialog>

  <!-- UUID search dialog -->
  <m:Dialog id="bpUuidDialog" title="{i18n>byUUID}" type="Message" contentWidth="480px">
    <m:content>
      <m:VBox class="sapUiSmallMargin">
        <m:HBox alignItems="Center">
          <m:Label text="{i18n>uuid}" width="8rem" />
          <m:Input id="bpUuidInput" width="22rem" placeholder="{i18n>bpUuidPlaceholder}" />
        </m:HBox>
      </m:VBox>
    </m:content>
    <m:beginButton>
      <m:Button text="{i18n>search}" type="Emphasized" press="onSearchByUuid" />
    </m:beginButton>
    <m:endButton>
      <m:Button text="{i18n>cancel}" press="onCloseUuidDialog" />
    </m:endButton>
  </m:Dialog>

</mvc:View>
