<mvc:View
  controllerName="studenthub.nov.controller.Students"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:m="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form"
  xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
  displayBlock="true">

  <m:Page id="studentsPage" title="{i18n>studentsTitle}" class="studentHubShell hubPage">

    <m:headerContent>
      <core:Fragment fragmentName="studenthub.nov.view.Nav" type="XML" />
    </m:headerContent>

    <m:content>
      <!-- Hero -->
      <m:VBox class="hubHero">
        <m:Title text="{i18n>studentsHeroTitle}" level="H1" titleStyle="H2" wrapping="true" />
        <m:Text text="{i18n>studentsHeroText}" class="hubHeroText" />
      </m:VBox>

      <!-- KPI tiles (click to filter by status) -->
      <m:FlexBox class="hubKpis" wrap="Wrap" alignItems="Stretch">
        <m:GenericTile id="kpiAll" class="hubKpi hubKpiSelected" header="{i18n>kpiAll}" frameType="OneByHalf" app:status="" press="onKpiPress">
          <m:TileContent>
            <m:NumericContent value="{local>/stats/total}" icon="sap-icon://group" valueColor="Neutral" withMargin="false" />
          </m:TileContent>
        </m:GenericTile>
        <m:GenericTile id="kpiActive" class="hubKpi hubKpiGood" header="{i18n>kpiActive}" frameType="OneByHalf" app:status="Active" press="onKpiPress">
          <m:TileContent>
            <m:NumericContent value="{local>/stats/Active}" icon="sap-icon://accept" valueColor="Good" withMargin="false" />
          </m:TileContent>
        </m:GenericTile>
        <m:GenericTile id="kpiInactive" class="hubKpi hubKpiWarn" header="{i18n>kpiInactive}" frameType="OneByHalf" app:status="Inactive" press="onKpiPress">
          <m:TileContent>
            <m:NumericContent value="{local>/stats/Inactive}" icon="sap-icon://pending" valueColor="Critical" withMargin="false" />
          </m:TileContent>
        </m:GenericTile>
        <m:GenericTile id="kpiSuspended" class="hubKpi hubKpiBad" header="{i18n>kpiSuspended}" frameType="OneByHalf" app:status="Suspended" press="onKpiPress">
          <m:TileContent>
            <m:NumericContent value="{local>/stats/Suspended}" icon="sap-icon://media-pause" valueColor="Error" withMargin="false" />
          </m:TileContent>
        </m:GenericTile>
        <m:GenericTile id="kpiGraduated" class="hubKpi hubKpiInfo" header="{i18n>kpiGraduated}" frameType="OneByHalf" app:status="Graduated" press="onKpiPress">
          <m:TileContent>
            <m:NumericContent value="{local>/stats/Graduated}" icon="sap-icon://education" valueColor="Neutral" withMargin="false" />
          </m:TileContent>
        </m:GenericTile>
      </m:FlexBox>

      <!-- Filters and page actions -->
      <m:OverflowToolbar class="hubFilterBar">
        <m:SearchField
          id="searchField"
          width="18rem"
          placeholder="{i18n>searchPlaceholder}"
          liveChange="onSearch"
          search="onSearch" />
        <m:Select id="departmentFilter" width="11rem" change="onDepartmentChange">
          <m:items>
            <core:Item key="" text="{i18n>allDepartments}" />
            <core:Item key="CSE" text="CSE" />
            <core:Item key="ECE" text="ECE" />
            <core:Item key="MBA" text="MBA" />
          </m:items>
        </m:Select>
        <m:Button text="{i18n>clearFilters}" icon="sap-icon://clear-filter" type="Transparent" press="onClearFilters" />
        <m:ToolbarSpacer />
        <m:Button text="{i18n>countButton}" icon="sap-icon://number-sign" type="Transparent" press="onStudentCount" />
        <m:Button text="{i18n>byDepartmentButton}" icon="sap-icon://group-2" type="Transparent" press="onOpenDepartmentDialog" />
        <m:Button icon="sap-icon://refresh" tooltip="{i18n>refresh}" type="Transparent" press="onRefresh" />
        <m:Button text="{i18n>createStudent}" icon="sap-icon://add-employee" type="Emphasized" press="onOpenCreateDialog" />
      </m:OverflowToolbar>

      <!-- Student list -->
      <m:VBox class="hubCard">
        <m:Table
          id="studentsTable"
          width="auto"
          growing="true"
          growingThreshold="25"
          growingScrollToLoad="true"
          busyIndicatorDelay="200"
          updateFinished="onUpdateFinished"
          items="{path: '/Students', sorter: {path: 'Name'}}">
          <m:headerToolbar>
            <m:OverflowToolbar>
              <m:Title id="tableTitle" text="{i18n>studentListTitle}" level="H2" />
              <m:ToolbarSpacer />
              <m:ObjectStatus id="countText" text="" state="Information" inverted="true" />
            </m:OverflowToolbar>
          </m:headerToolbar>
          <m:noData>
            <m:IllustratedMessage illustrationType="sapIllus-NoSearchResults" illustrationSize="Spot" title="{i18n>noStudents}" description="{i18n>noStudentsHint}" enableVerticalResponsiveness="true" />
          </m:noData>
          <m:columns>
            <m:Column><m:Text text="{i18n>name}" /></m:Column>
            <m:Column width="9rem"><m:Text text="{i18n>department}" /></m:Column>
            <m:Column width="9rem"><m:Text text="{i18n>status}" /></m:Column>
            <m:Column width="9rem" minScreenWidth="Desktop" demandPopin="true"><m:Text text="{i18n>bpNumber}" /></m:Column>
            <m:Column width="11rem" hAlign="End"><m:Text text="{i18n>actions}" /></m:Column>
          </m:columns>
          <m:items>
            <m:ColumnListItem vAlign="Middle" type="Navigation" press="onRowPress">
              <m:cells>
                <m:HBox alignItems="Center">
                  <m:Avatar
                    initials="{path: 'Name', formatter: '.formatInitials'}"
                    backgroundColor="{path: 'department', formatter: '.formatDeptColor'}"
                    displaySize="S" displayShape="Circle" class="sapUiSmallMarginEnd" />
                  <m:ObjectIdentifier title="{Name}" text="{Email}" />
                </m:HBox>
                <m:ObjectStatus text="{department}" class="hubDeptTag" />
                <m:ObjectStatus
                  text="{status}"
                  inverted="true"
                  icon="{path: 'status', formatter: '.formatStatusIcon'}"
                  state="{path: 'status', formatter: '.formatStatusState'}" />
                <m:Text text="{bpNumber}" class="hubMono" />
                <m:HBox class="hubActions" justifyContent="End" wrap="NoWrap">
                  <m:Button icon="sap-icon://add" tooltip="{i18n>enrollInCourse}" type="Transparent" press="onOpenEnrollDialog" />
                  <m:Button icon="sap-icon://edit" tooltip="{i18n>editStudent}" type="Transparent" press="onEditStudent" />
                  <m:Button icon="sap-icon://delete" tooltip="{i18n>delete}" type="Transparent" class="hubDanger" press="onDelete" />
                  <m:Button icon="sap-icon://overflow" tooltip="{i18n>moreActions}" type="Transparent" press="onOpenMoreMenu">
                    <m:dependents>
                      <m:Menu>
                        <m:MenuItem text="{i18n>viewEnrolledCourses}" icon="sap-icon://course-book" press="onViewCourses" />
                        <m:MenuItem text="{i18n>averageCredits}" icon="sap-icon://average" press="onAverageCredits" />
                        <m:MenuItem text="{i18n>changeDepartment}" icon="sap-icon://building" press="onOpenChangeDepartmentDialog" />
                        <m:MenuItem
                          text="{path: 'status', formatter: '.formatSuspendText'}"
                          icon="{path: 'status', formatter: '.formatSuspendIcon'}"
                          enabled="{= ${path: 'status', targetType: 'any'} !== 'Graduated' }"
                          startsSection="true"
                          press="onToggleSuspend" />
                        <m:MenuItem text="{i18n>graduate}" icon="sap-icon://education" enabled="{= ${path: 'status', targetType: 'any'} !== 'Graduated' }" press="onGraduate" />
                      </m:Menu>
                    </m:dependents>
                  </m:Button>
                </m:HBox>
              </m:cells>
            </m:ColumnListItem>
          </m:items>
        </m:Table>
      </m:VBox>
    </m:content>

    <m:footer>
      <m:OverflowToolbar>
        <core:Icon src="sap-icon://hint" class="sapUiTinyMarginEnd" />
        <m:Text text="{i18n>footerHint}" />
      </m:OverflowToolbar>
    </m:footer>
  </m:Page>

  <!-- Create / edit student dialog -->
  <m:Dialog id="createDialog" title="{i18n>createStudent}" contentWidth="32rem" icon="sap-icon://employee" class="hubDialog">
    <m:content>
      <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4" labelSpanL="4" columnsM="1" columnsL="1">
        <f:content>
          <m:Label text="{i18n>name}" required="true" />
          <m:Input id="newName" maxLength="20" placeholder="{i18n>namePlaceholder}" showValueStateMessage="true" />
          <m:Label text="{i18n>email}" required="true" />
          <m:Input id="newEmail" type="Email" maxLength="100" placeholder="name@example.com" />
          <m:Label text="{i18n>department}" />
          <m:SegmentedButton id="newDepartment" selectedKey="CSE">
            <m:items>
              <m:SegmentedButtonItem key="CSE" text="CSE" />
              <m:SegmentedButtonItem key="ECE" text="ECE" />
              <m:SegmentedButtonItem key="MBA" text="MBA" />
            </m:items>
          </m:SegmentedButton>
          <m:Label text="{i18n>status}" />
          <m:Select id="newStatus" width="100%">
            <m:items>
              <core:Item key="Active" text="Active" />
              <core:Item key="Inactive" text="Inactive" />
            </m:items>
          </m:Select>
          <m:Label text="{i18n>bpNumber}" required="true" />
          <m:Input id="newBpNumber" maxLength="20" placeholder="e.g. 1000000001" />
          <m:Label text="{i18n>id}" />
          <m:Input id="newId" placeholder="{i18n>idPlaceholder}" />
        </f:content>
      </f:SimpleForm>
    </m:content>
    <m:beginButton>
      <m:Button text="{i18n>create}" type="Emphasized" press="onSaveNewStudent" />
    </m:beginButton>
    <m:endButton>
      <m:Button text="{i18n>cancel}" press="onCloseCreateDialog" />
    </m:endButton>
  </m:Dialog>

  <!-- Enroll dialog -->
  <m:Dialog id="enrollDialog" title="{i18n>enrollInCourse}" contentWidth="28rem" icon="sap-icon://study-leave" class="hubDialog">
    <m:content>
      <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="3" labelSpanL="3" columnsM="1" columnsL="1">
        <f:content>
          <m:Label text="{i18n>student}" />
          <m:Text id="enrollStudentName" />
          <m:Label text="{i18n>course}" required="true" />
          <m:ComboBox id="courseSelect" width="100%" placeholder="{i18n>pickCourse}" items="{path: '/Courses', sorter: {path: 'code'}, templateShareable: false}">
            <core:ListItem key="{code}" text="{code} · {title}" additionalText="{credits} cr" />
          </m:ComboBox>
        </f:content>
      </f:SimpleForm>
    </m:content>
    <m:beginButton>
      <m:Button text="{i18n>enroll}" type="Emphasized" press="onEnroll" />
    </m:beginButton>
    <m:endButton>
      <m:Button text="{i18n>cancel}" press="onCloseEnrollDialog" />
    </m:endButton>
  </m:Dialog>

  <!-- Enrolled courses dialog -->
  <m:Dialog id="enrolledCoursesDialog" title="{i18n>enrolledCourses}" contentWidth="640px" icon="sap-icon://course-book" class="hubDialog">
    <m:content>
      <m:Table id="enrolledCoursesTable" width="100%" items="{local>/courses}" noDataText="{i18n>noEnrollments}">
        <m:columns>
          <m:Column width="6rem"><m:Text text="{i18n>code}" /></m:Column>
          <m:Column><m:Text text="{i18n>title}" /></m:Column>
          <m:Column width="5rem" hAlign="End"><m:Text text="{i18n>credits}" /></m:Column>
          <m:Column minScreenWidth="Tablet" demandPopin="true"><m:Text text="{i18n>teacher}" /></m:Column>
          <m:Column width="4rem" hAlign="End"><m:Text text="" /></m:Column>
        </m:columns>
        <m:items>
          <m:ColumnListItem vAlign="Middle">
            <m:cells>
              <m:ObjectStatus text="{local>code}" state="Information" inverted="true" />
              <m:Text text="{local>title}" />
              <m:ObjectNumber number="{local>credits}" unit="cr" />
              <m:Text text="{local>teacher}" />
              <m:Button icon="sap-icon://decline" tooltip="{i18n>dropCourse}" type="Transparent" class="hubDanger" press="onDropCourse" />
            </m:cells>
          </m:ColumnListItem>
        </m:items>
      </m:Table>
    </m:content>
    <m:endButton>
      <m:Button text="{i18n>close}" press="onCloseCoursesDialog" />
    </m:endButton>
  </m:Dialog>

  <!-- Change department dialog (bound action) -->
  <m:Dialog id="changeDepartmentDialog" title="{i18n>changeDepartment}" contentWidth="28rem" icon="sap-icon://building" class="hubDialog">
    <m:content>
      <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4" labelSpanL="4" columnsM="1" columnsL="1">
        <f:content>
          <m:Label text="{i18n>name}" />
          <m:Text id="changeDeptStudentName" />
          <m:Label text="{i18n>department}" />
          <m:SegmentedButton id="changeDepartmentSelect">
            <m:items>
              <m:SegmentedButtonItem key="CSE" text="CSE" />
              <m:SegmentedButtonItem key="ECE" text="ECE" />
              <m:SegmentedButtonItem key="MBA" text="MBA" />
            </m:items>
          </m:SegmentedButton>
        </f:content>
      </f:SimpleForm>
    </m:content>
    <m:beginButton>
      <m:Button text="{i18n>save}" type="Emphasized" press="onChangeDepartment" />
    </m:beginButton>
    <m:endButton>
      <m:Button text="{i18n>cancel}" press="onCloseChangeDepartmentDialog" />
    </m:endButton>
  </m:Dialog>

  <!-- Students by department dialog (unbound function) -->
  <m:Dialog id="departmentDialog" title="{i18n>byDepartmentButton}" contentWidth="560px" contentHeight="28rem" icon="sap-icon://group-2" class="hubDialog">
    <m:subHeader>
      <m:Toolbar>
        <m:SegmentedButton id="departmentSearchSelect" selectedKey="CSE" selectionChange="onSearchByDepartment">
          <m:items>
            <m:SegmentedButtonItem key="CSE" text="CSE" />
            <m:SegmentedButtonItem key="ECE" text="ECE" />
            <m:SegmentedButtonItem key="MBA" text="MBA" />
          </m:items>
        </m:SegmentedButton>
        <m:ToolbarSpacer />
        <m:ObjectStatus text="{= ${local>/departmentStudents}.length }" icon="sap-icon://group" state="Information" inverted="true" />
      </m:Toolbar>
    </m:subHeader>
    <m:content>
      <m:List id="departmentResults" items="{local>/departmentStudents}" noDataText="{i18n>noStudents}">
        <m:StandardListItem
          title="{local>Name}"
          description="{local>Email}"
          info="{local>status}"
          infoState="{path: 'local>status', formatter: '.formatStatusState'}"
          icon="sap-icon://person-placeholder" />
      </m:List>
    </m:content>
    <m:endButton>
      <m:Button text="{i18n>close}" press="onCloseDepartmentDialog" />
    </m:endButton>
  </m:Dialog>

</mvc:View>
