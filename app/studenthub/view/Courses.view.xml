<mvc:View
  controllerName="studenthub.nov.controller.Courses"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:m="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form"
  displayBlock="true">

  <m:Page id="coursesPage" title="{i18n>coursesTitle}" class="studentHubShell">

    <m:headerContent>
      <core:Fragment fragmentName="studenthub.nov.view.Nav" type="XML" />
    </m:headerContent>

    <m:content>
      <m:FlexBox class="hubKpis" wrap="Wrap">
        <m:GenericTile class="hubKpi" header="{i18n>navCourses}" frameType="OneByHalf">
          <m:TileContent>
            <m:NumericContent value="{seats>/courseCount}" icon="sap-icon://course-book" withMargin="false" />
          </m:TileContent>
        </m:GenericTile>
        <m:GenericTile class="hubKpi" header="{i18n>seatsTaken}" frameType="OneByHalf">
          <m:TileContent>
            <m:NumericContent value="{seats>/taken}" icon="sap-icon://study-leave" valueColor="Good" withMargin="false" />
          </m:TileContent>
        </m:GenericTile>
        <m:GenericTile class="hubKpi" header="{i18n>seatsFree}" frameType="OneByHalf">
          <m:TileContent>
            <m:NumericContent value="{seats>/free}" icon="sap-icon://sys-add" withMargin="false" />
          </m:TileContent>
        </m:GenericTile>
      </m:FlexBox>

      <m:OverflowToolbar class="hubFilterBar">
        <m:SearchField id="courseSearch" width="18rem" placeholder="{i18n>courseSearchPlaceholder}" liveChange="onSearch" search="onSearch" />
        <m:ToolbarSpacer />
        <m:Button icon="sap-icon://refresh" tooltip="{i18n>refresh}" type="Transparent" press="onRefresh" />
        <m:Button text="{i18n>newCourse}" icon="sap-icon://add" type="Emphasized" press="onOpenCreate" />
      </m:OverflowToolbar>

      <m:VBox class="hubCard">
        <m:Table id="coursesTable" width="auto" growing="true" items="{path: '/Courses', sorter: {path: 'code'}}" busyIndicatorDelay="200">
          <m:noData>
            <m:IllustratedMessage illustrationType="sapIllus-NoSearchResults" illustrationSize="Spot" title="{i18n>noCourses}" description="{i18n>noCoursesHint}" enableVerticalResponsiveness="true" />
          </m:noData>
          <m:headerToolbar>
            <m:OverflowToolbar>
              <m:Title text="{i18n>navCourses}" level="H2" />
            </m:OverflowToolbar>
          </m:headerToolbar>
          <m:columns>
            <m:Column width="7rem"><m:Text text="{i18n>code}" /></m:Column>
            <m:Column><m:Text text="{i18n>title}" /></m:Column>
            <m:Column minScreenWidth="Tablet" demandPopin="true"><m:Text text="{i18n>teacher}" /></m:Column>
            <m:Column width="6rem" hAlign="End"><m:Text text="{i18n>credits}" /></m:Column>
            <m:Column width="14rem" minScreenWidth="Tablet" demandPopin="true"><m:Text text="{i18n>seats}" /></m:Column>
            <m:Column width="9rem" hAlign="End"><m:Text text="{i18n>actions}" /></m:Column>
          </m:columns>
          <m:items>
            <m:ColumnListItem vAlign="Middle">
              <m:cells>
                <m:ObjectStatus text="{code}" state="Information" inverted="true" />
                <m:ObjectIdentifier title="{title}" />
                <m:HBox alignItems="Center">
                  <core:Icon src="sap-icon://person-placeholder" class="sapUiTinyMarginEnd hubMutedIcon" />
                  <m:Text text="{teacher}" />
                </m:HBox>
                <m:ObjectNumber number="{credits}" unit="cr" />
                <m:ProgressIndicator
                  height="1rem"
                  percentValue="{parts: [{path: 'code', targetType: 'any'}, {path: 'capacity', targetType: 'any'}, 'seats>/byCourse'], formatter: '.formatSeatPercent'}"
                  displayValue="{parts: [{path: 'code', targetType: 'any'}, {path: 'capacity', targetType: 'any'}, 'seats>/byCourse'], formatter: '.formatSeatText'}"
                  state="{parts: [{path: 'code', targetType: 'any'}, {path: 'capacity', targetType: 'any'}, 'seats>/byCourse'], formatter: '.formatSeatState'}" />
                <m:HBox class="hubActions" justifyContent="End" wrap="NoWrap">
                  <m:Button icon="sap-icon://group" tooltip="{i18n>viewEnrolledStudents}" type="Transparent" press="onViewStudents" />
                  <m:Button icon="sap-icon://edit" tooltip="{i18n>editCourse}" type="Transparent" press="onOpenEdit" />
                  <m:Button icon="sap-icon://delete" tooltip="{i18n>deleteCourse}" type="Transparent" class="hubDanger" press="onDelete" />
                </m:HBox>
              </m:cells>
            </m:ColumnListItem>
          </m:items>
        </m:Table>
      </m:VBox>
    </m:content>
  </m:Page>

  <m:Dialog id="courseDialog" title="{i18n>newCourse}" contentWidth="30rem" icon="sap-icon://course-book" class="hubDialog">
    <m:content>
      <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4" labelSpanL="4" columnsM="1" columnsL="1">
        <f:content>
          <m:Label text="{i18n>code}" required="true" />
          <m:Input id="courseCode" maxLength="10" placeholder="e.g. CS201" />
          <m:Label text="{i18n>title}" required="true" />
          <m:Input id="courseTitle" maxLength="100" />
          <m:Label text="{i18n>teacher}" />
          <m:Input id="courseTeacher" maxLength="100" />
          <m:Label text="{i18n>credits}" />
          <m:StepInput id="courseCredits" min="1" max="10" value="3" />
          <m:Label text="{i18n>capacity}" />
          <m:StepInput id="courseCapacity" min="1" max="500" step="5" value="40" />
        </f:content>
      </f:SimpleForm>
    </m:content>
    <m:beginButton>
      <m:Button id="courseSaveButton" text="{i18n>create}" type="Emphasized" press="onSave" />
    </m:beginButton>
    <m:endButton>
      <m:Button text="{i18n>cancel}" press="onCloseDialog" />
    </m:endButton>
  </m:Dialog>

</mvc:View>
